# UIProof AI Backend Settings
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# CORS Configuration (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Future integrations (stubs)
LLM_PROVIDER=openai
LLM_API_KEY=mock-llm-key-placeholder
POSTGRES_URI=postgresql://postgres:postgres@localhost:5432/uiproof_ai

# Security / JWT Configuration
JWT_SECRET_KEY=change-this-development-secret-key-32chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
