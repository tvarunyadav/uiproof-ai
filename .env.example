# UIProof AI Global Environment Variables Example

# Backend Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# AI Provider Settings (Stubs for future milestone)
LLM_PROVIDER=openai
LLM_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o

# Database (Stubs for future milestone)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=uiproof_ai

# Frontend Settings
VITE_API_BASE_URL=http://localhost:8000/api/v1
